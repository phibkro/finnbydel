{
  "compilerOptions": {
    "lib": ["es2023"],
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "bun-types"],
    "noEmit": true
  },
  "include": ["src/**/*"]
}
