// Schema for the bydel-lookup architecture:
//   * City — the 4 supported cities (Oslo, Bergen, Trondheim, Stavanger).
//   * Bydel — administrative borough polygons. GeoJSON stored as text;
//     bounding-box columns enable cheap pre-filter before exact PIP.
//
// Lookup flow (see src/server/api/routers/bydel.ts):
//   1. Address-string → Geonorge `/adresser/v1/sok` → coords (lat/lon).
//   2. coords → bbox-prefiltered Bydel candidates → exact JS-side PIP
//      (turf) → matching bydel name.
//
// Old Address table (with bulk-seeded street/district fields) is gone —
// the PIP approach reads addresses on-demand from Geonorge's open API
// instead of mirroring the entire registry locally.

datasource db {
    provider = "sqlite"
    url      = env("DATABASE_URL")
}

generator client {
    provider = "prisma-client-js"
}

model City {
    id      Int     @id @default(autoincrement())
    name    String  @unique // "Oslo", "Bergen", "Trondheim", "Stavanger"
    bydeler Bydel[]
}

model Bydel {
    id     Int    @id @default(autoincrement())
    name   String
    cityId Int
    city   City   @relation(fields: [cityId], references: [id])

    // GeoJSON Polygon or MultiPolygon, JSON-stringified. Read by
    // @turf/boolean-point-in-polygon at lookup time.
    geometryJson String

    // Bounding box for cheap pre-filter — narrows ~10 candidates to
    // ~1 before running expensive PIP. Coordinates in WGS84 / EPSG:4258
    // (lon = X, lat = Y). Geonorge returns EPSG:4258 by default.
    minLon Float
    minLat Float
    maxLon Float
    maxLat Float

    @@unique([cityId, name])
    @@index([cityId])
}
